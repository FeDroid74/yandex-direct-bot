APP_HOST=127.0.0.1
APP_PORT=8091

# false = production, true = sandbox
YANDEX_DIRECT_USE_SANDBOX=true

# OAuth token for Yandex Direct user
YANDEX_DIRECT_OAUTH_TOKEN=

# Required only if requests are made on behalf of an agency client
YANDEX_DIRECT_CLIENT_LOGIN=

# ru or en
YANDEX_DIRECT_ACCEPT_LANGUAGE=ru
